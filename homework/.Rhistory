library(tidyverse)
GDP <- read.csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/gdp_djia.csv")
View(GDP)
GDP |> summarize(correlation = cor(GDP, DJIA, method = "pearson"))
GDP |>
ggplot() +
geom_point(aes(x=DJIA, y=GDP)) +
geom_smooth(aes(x=DJIA, y=DJIA), method="lm")
labs(title = "DJIA v GDP", x = "DJIA", y = "GDP")
