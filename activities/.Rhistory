library(tidyverse)
matches <- read_csv("https://raw.githubusercontent.com/dwillis/NCAAWomensVolleyballData/refs/heads/main/data/ncaa_womens_volleyball_matchstats_2024.csv")
View(matches)
team_aces <- matches |>
group_by(team) |>
summarize(total_aces = sum(aces)) |>
arrange(desc(total_aces))
View(team_aces)
team_aces |> mutate(percentile = ntile(total_aces, 100))
View(team_aces)
team_aces |> mutate(percentile = ntile(total_aces, 100))
View(team_aces)
library(tidyverse)
car_thefts <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/car_thefts_jan24.csv")
View(car_thefts)
car_thefts |> summarize(mean = mean(count), sd = sd(count))
car_thefts |>
ggplot() +
geom_histogram(aes(x = count), binwidth = 2)
car_thefts |>
ggplot() +
geom_histogram(aes(x = count), binwidth = 2) +
geom_vline(aes(xintercept = mean(count)), color = "red", linetype = "dashed", size = 1) +
geom_vline(aes(xintercept = mean(count) - sd(count)), color = "blue", linetype = "dashed", size = 1) +
geom_vline(aes(xintercept = mean(count) + sd(count)), color = "blue", linetype = "dashed", size = 1)
car_thefts |>
ggplot() +
geom_histogram(aes(x = count), binwidth = 2) +
geom_vline(aes(xintercept = mean(count)), color = "red", linetype = "dashed", size = 1) +
geom_vline(aes(xintercept = mean(count) - sd(count)), color = "pink", linetype = "dashed", size = 1) +
geom_vline(aes(xintercept = mean(count) + sd(count)), color = "pink", linetype = "dashed", size = 1)
car_thefts |>
ggplot() +
geom_histogram(aes(x = count), binwidth = 2) +
geom_vline(aes(xintercept = mean(count)), color = "red", linetype = "dashed", size = 1) +
geom_vline(aes(xintercept = mean(count) - sd(count)), color = "blue", linetype = "dashed", size = 1) +
geom_vline(aes(xintercept = mean(count) + sd(count)), color = "blue", linetype = "dashed", size = 1)
knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(tidyverse)
library(tidyverse)
health_scores <- read.csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/montco_inspections.csv")
compliance_stats <- health_scores |>
summarize(mean = mean (compliance_score), sd = sd(compliance_score), min = min(compliance_score), max = max(compliance_score))
health_scores |>
ggplot(aes(x = compliance_score)) +
geom_histogram(binwidth = 3) +
geom_vline(aes(xintercept = mean(compliance_score)), color = "red", linetype = "dashed", size =1 ) +
labs(title = "Frequency of Compliance Scores", x = "Compliance Score", y = "Count")
participation_data <- read.csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/md_hs_participation.csv")
participation_data <- read.csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/md_hs_participation.csv")
participation_averages <- participation_data |>
mutate(total = boys + girls) |>
mutate(girls_pct = (girls/total) * 100)
participation_averages |> summarize (correlation = cor(boys, girls, method = "pearson"))
participation_averages |>
ggplot(aes(x = girls, y = boys)) +
geom_point(color = "red") +
geom_smooth(aes(x=girls, y=boys), method="lm") +
labs(title = "Relationship of Girls and Boys in High School Sports", x = "Girls Participation", y = "Boys Participation")
car_thefts <- read.csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/md_car_thefts.csv")
car_theft_rates <- car_thefts |>
mutate(grand_totals = X2022+X2023) |>
mutate(total_rate = grand_totals/population * 10000)
car_theft_rates |>
summarize(median_rate = median(total_rate), median_thefts = median(grand_totals))
